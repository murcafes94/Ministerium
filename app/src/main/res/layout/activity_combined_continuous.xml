<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/txtCombinedMassTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hora con Misa"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCombinedMassCelebration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preparando celebración…"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCombinedTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◐" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/groupCombinedStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <RadioButton
            android:id="@+id/startHoursVerse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Versículo + himno" />

        <RadioButton
            android:id="@+id/startMassEntrance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Entrada de la Misa" />
    </RadioGroup>

    <TextView
        android:id="@+id/txtCombinedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="OGLH 93–96 · un solo recorrido"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/combinedWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
