+package com.fabri.ministerium;
+
+import android.os.Bundle;
+import android.view.View;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import java.util.Locale;
+
+/** Lector aislado para el paquete de pruebas que no forma parte de la edición pública. */
+public final class PrivateDailyHoursActivity extends ThemedActivity {
+    public static final String EXTRA_YEAR = "private_hours_year";
+    public static final String EXTRA_MONTH = "private_hours_month";
+    public static final String EXTRA_DAY = "private_hours_day";
+    public static final String EXTRA_HOUR = "private_hours_hour";
+    public static final String EXTRA_TITLE = "private_hours_title";
+    private static final String[] MONTHS = {"ene", "feb", "mar", "abr", "may", "jun",
+            "jul", "ago", "sep", "oct", "nov", "dic"};
+
+    @Override protected void onCreate(Bundle state) {
+        ThemeUtils.apply(this);
+        super.onCreate(state);
+        setContentView(R.layout.activity_hours_reader);
+        findViewById(R.id.btnBack).setOnClickListener(v -> finish());
+        findViewById(R.id.btnReaderSearch).setVisibility(View.GONE);
+        findViewById(R.id.btnReaderTheme).setVisibility(View.GONE);
+        findViewById(R.id.btnReaderMore).setVisibility(View.GONE);
+        findViewById(R.id.btnGlobalMenu).setVisibility(View.GONE);
+
+        String title = getIntent().getStringExtra(EXTRA_TITLE);
+        ((TextView) findViewById(R.id.txtReaderTitle)).setText(title == null ? "Liturgia de las Horas" : title);
+        ((TextView) findViewById(R.id.txtReaderSubtitle)).setText("Edición privada de prueba · fuente externa");
+
+        int year = getIntent().getIntExtra(EXTRA_YEAR, 0);
+        int month = getIntent().getIntExtra(EXTRA_MONTH, 0);
+        int day = getIntent().getIntExtra(EXTRA_DAY, 0);
+        String hour = getIntent().getStringExtra(EXTRA_HOUR);
+        String path = String.format(Locale.US, "private-hours/%d/%s/%02d/%s.htm",
+                year, MONTHS[Math.max(0, Math.min(11, month))], day, hour);
+        MinisteriumWebView webView = findViewById(R.id.hoursWebView);
+        webView.getSettings().setJavaScriptEnabled(false);
+        webView.getSettings().setAllowContentAccess(false);
+        webView.getSettings().setAllowFileAccess(true);
+        webView.setWebViewClient(new WebViewClient() {
+            @Override public void onPageFinished(WebView view, String url) {
+                ReaderPreferences.apply(PrivateDailyHoursActivity.this, view, false);
+            }
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                String url = request.getUrl().toString();
+                return !url.startsWith("file:///android_asset/private-hours/");
+            }
+            @Override public void onReceivedError(WebView view, int code, String description, String failingUrl) {
+                Toast.makeText(PrivateDailyHoursActivity.this,
+                        "Esta fecha no está incluida en el paquete privado.", Toast.LENGTH_LONG).show();
+            }
+        });
+        UniversalSelectionMenu.attach(this, webView,
+                new ReaderContext("Liturgia de las Horas", path, title, title,
+                        "Liturgia de las Horas", true));
+        webView.loadUrl("file:///android_asset/" + path);
+    }
+}
