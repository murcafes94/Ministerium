diff --git a/recovered-v3/tools/build_private_hours.py b/recovered-v3/tools/build_private_hours.py
new file mode 100644
index 0000000..1b47000
--- /dev/null
+++ b/recovered-v3/tools/build_private_hours.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""Crea el paquete anual privado sin incorporar la fuente al repositorio."""
+from pathlib import Path
+import argparse, shutil
+
+MONTHS = ("ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic")
+HOURS = ("oficio.htm", "laudes.htm", "tercia.htm", "sexta.htm", "nona.htm", "visperas.htm", "completas.htm")
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("source", type=Path)
+    parser.add_argument("--year", type=int, required=True)
+    parser.add_argument("--output", type=Path, default=Path("app/src/privateEdition/assets/private-hours"))
+    args = parser.parse_args()
+    source_year = args.source / "sync" / str(args.year)
+    target_year = args.output / str(args.year)
+    if not source_year.is_dir():
+        raise SystemExit(f"No existe el año {args.year} en {source_year}")
+    if target_year.exists():
+        shutil.rmtree(target_year)
+    copied = 0
+    for month in MONTHS:
+        month_dir = source_year / month
+        if not month_dir.is_dir():
+            continue
+        for day_dir in sorted(p for p in month_dir.iterdir() if p.is_dir()):
+            destination = target_year / month / day_dir.name
+            for name in HOURS:
+                source = day_dir / name
+                if source.is_file():
+                    destination.mkdir(parents=True, exist_ok=True)
+                    shutil.copy2(source, destination / name)
+                    copied += 1
+    if copied < 300:
+        raise SystemExit(f"Paquete incompleto: solo {copied} oficios")
+    print(f"Paquete privado {args.year}: {copied} archivos")
+
+if __name__ == "__main__":
+    main()
