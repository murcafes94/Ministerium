<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ministerium_surface_pressed" />
            <corners android:radius="@dimen/ministerium_card_radius" />
            <stroke android:width="1dp" android:color="@color/ministerium_accent_secondary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ministerium_surface" />
            <corners android:radius="@dimen/ministerium_card_radius" />
            <stroke android:width="1dp" android:color="@color/ministerium_divider" />
        </shape>
    </item>
</selector>
