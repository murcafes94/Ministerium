<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <LinearLayout
        android:id="@+id/combinedMassHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/wine_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/reader_header_padding">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/reader_icon_touch"
            android:layout_height="@dimen/reader_icon_touch"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="@dimen/reader_icon_padding"
            android:src="@drawable/ic_nav_back"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtCombinedMassTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/reader_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCombinedMassSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Preparando celebración…"
                android:textColor="#E9DBD7"
                android:textSize="@dimen/reader_subtitle_size" />
        </LinearLayout>
    </LinearLayout>

    <com.fabri.ministerium.MinisteriumWebView
        android:id="@+id/combinedMassWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/reader_content_margin"
        android:layout_weight="1"
        android:background="@drawable/bg_reading_surface" />

</LinearLayout>
