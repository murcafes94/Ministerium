<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/wine_dark" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="10dp">
        <Button android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@android:color/transparent" android:text="‹" android:textColor="#FFFFFF" android:textSize="28sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Liturgia bilingüe" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Español · Latín" android:textColor="#E9DBD7" android:textSize="12sp" /></LinearLayout>
        <Button android:id="@+id/btnCalendar" android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@android:color/transparent" android:contentDescription="Elegir fecha" android:text="▣" android:textColor="@color/gold" android:textSize="22sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/bilingualContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="26dp" android:visibility="invisible">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="12dp">
                    <Button android:id="@+id/btnPreviousDay" android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@android:color/transparent" android:text="‹" android:textColor="@color/wine" android:textSize="30sp" />
                    <TextView android:id="@+id/txtBilingualDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnNextDay" android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@android:color/transparent" android:text="›" android:textColor="@color/wine" android:textSize="30sp" />
                </LinearLayout>
                <TextView android:id="@+id/txtBilingualCelebration" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_marginTop="10dp" android:layout_marginEnd="22dp" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtBilingualDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_marginTop="4dp" android:layout_marginEnd="22dp" android:textColor="@color/wine" android:textSize="12sp" />
                <TextView android:id="@+id/txtBilingualStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_marginTop="12dp" android:layout_marginEnd="22dp" android:background="@drawable/bg_card" android:padding="14dp" android:textColor="@color/muted" android:textSize="12sp" />
                <Button android:id="@+id/btnChooseOffice" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="22dp" android:layout_marginTop="12dp" android:layout_marginEnd="22dp" android:background="@drawable/bg_button_secondary" android:text="Elegir celebración para el español" android:textAllCaps="false" android:textColor="@color/wine" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_marginTop="20dp" android:letterSpacing="0.1" android:text="HORAS EN PARALELO" android:textColor="@color/wine" android:textSize="12sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="11dp" android:paddingTop="5dp" android:paddingEnd="11dp"><LinearLayout android:id="@+id/cardInvitatory" style="@style/DailyHourCard"><TextView style="@style/DailyHourTitle" android:text="Invitatorio" /><TextView style="@style/DailyHourSubtitle" android:text="Invitatorium" /></LinearLayout><LinearLayout android:id="@+id/cardOfficeReadings" style="@style/DailyHourCard"><TextView style="@style/DailyHourTitle" android:text="Oficio" /><TextView style="@style/DailyHourSubtitle" android:text="Officium lectionis" /></LinearLayout></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="11dp" android:paddingEnd="11dp"><LinearLayout android:id="@+id/cardLauds" style="@style/DailyHourCard"><TextView style="@style/DailyHourTitle" android:text="Laudes" /><TextView style="@style/DailyHourSubtitle" android:text="Laudes matutinæ" /></LinearLayout><LinearLayout android:id="@+id/cardTerce" style="@style/DailyHourCard"><TextView style="@style/DailyHourTitle" android:text="Tercia" /><TextView style="@style/DailyHourSubtitle" android:text="Tertia" /></LinearLayout></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="11dp" android:paddingEnd="11dp"><LinearLayout android:id="@+id/cardSext" style="@style/DailyHourCard"><TextView style="@style/DailyHourTitle" android:text="Sexta" /><TextView style="@style/DailyHourSubtitle" android:text="Sexta" /></LinearLayout><LinearLayout android:id="@+id/cardNone" style="@style/DailyHourCard"><TextView style="@style/DailyHourTitle" android:text="Nona" /><TextView style="@style/DailyHourSubtitle" android:text="Nona" /></LinearLayout></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="11dp" android:paddingEnd="11dp"><LinearLayout android:id="@+id/cardVespers" style="@style/DailyHourCard"><TextView style="@style/DailyHourTitle" android:text="Vísperas" /><TextView style="@style/DailyHourSubtitle" android:text="Vesperæ" /></LinearLayout><LinearLayout android:id="@+id/cardCompline" style="@style/DailyHourCard"><TextView style="@style/DailyHourTitle" android:text="Completas" /><TextView style="@style/DailyHourSubtitle" android:text="Completorium" /></LinearLayout></LinearLayout>
                <Button android:id="@+id/btnManageLatin" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="22dp" android:layout_marginTop="18dp" android:layout_marginEnd="22dp" android:background="@drawable/bg_button_secondary" android:text="Administrar años de la edición latina" android:textAllCaps="false" android:textColor="@color/wine" />
            </LinearLayout>
        </ScrollView>
        <ProgressBar android:id="@+id/bilingualProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
