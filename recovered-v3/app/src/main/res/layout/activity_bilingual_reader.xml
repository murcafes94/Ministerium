<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">

    <LinearLayout android:id="@+id/readerHeader" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@color/wine_dark"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:padding="@dimen/reader_header_padding">
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="@dimen/reader_icon_touch"
            android:layout_height="@dimen/reader_icon_touch"
            android:background="@android:color/transparent" android:contentDescription="Volver"
            android:padding="@dimen/reader_icon_padding" android:src="@drawable/ic_nav_back"
            android:tint="#FFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txtReaderTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:textColor="#FFFFFF" android:textSize="@dimen/reader_title_size"
                android:textStyle="bold" />
            <TextView android:id="@+id/txtReaderSubtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:textColor="#E9DBD7" android:textSize="@dimen/reader_subtitle_size" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnReaderTheme"
            android:layout_width="@dimen/reader_icon_touch"
            android:layout_height="@dimen/reader_icon_touch"
            android:background="@android:color/transparent" android:contentDescription="Cambiar tema"
            android:padding="@dimen/reader_icon_padding" android:src="@drawable/ic_theme"
            android:tint="@color/gold" />
        <ImageButton android:id="@+id/btnReaderMore"
            android:layout_width="@dimen/reader_icon_touch"
            android:layout_height="@dimen/reader_icon_touch"
            android:background="@android:color/transparent" android:contentDescription="Más opciones"
            android:padding="@dimen/reader_icon_padding" android:src="@drawable/ic_more_vert"
            android:tint="@color/gold" />
        <ImageButton android:id="@+id/btnGlobalMenu"
            android:layout_width="@dimen/reader_icon_touch"
            android:layout_height="@dimen/reader_icon_touch"
            android:background="@android:color/transparent" android:contentDescription="Menú global"
            android:padding="@dimen/reader_icon_padding" android:src="@drawable/ic_menu"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="@dimen/reader_mode_height" android:gravity="center"
        android:orientation="horizontal" android:paddingStart="@dimen/reader_content_margin"
        android:paddingEnd="@dimen/reader_content_margin">
        <Button android:id="@+id/btnBoth" android:layout_width="0dp"
            android:layout_height="@dimen/reader_mode_button_height" android:layout_weight="1"
            android:background="@drawable/bg_button" android:text="Bilingüe"
            android:textAllCaps="false" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnLatin" android:layout_width="0dp"
            android:layout_height="@dimen/reader_mode_button_height"
            android:layout_marginStart="@dimen/reader_column_gap" android:layout_weight="1"
            android:background="@drawable/bg_button_secondary" android:text="Latín"
            android:textAllCaps="false" android:textColor="@color/wine" />
    </LinearLayout>

    <LinearLayout android:id="@+id/bilingualPanes" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <com.fabri.ministerium.BilingualSyncWebView android:id="@+id/spanishWebView"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="@dimen/reader_column_gap" android:layout_weight="1"
            android:background="@drawable/bg_reading_surface" />
        <com.fabri.ministerium.BilingualSyncWebView android:id="@+id/latinWebView"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_margin="@dimen/reader_column_gap" android:layout_weight="1"
            android:background="@drawable/bg_reading_surface" />
    </LinearLayout>
</LinearLayout>
