<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:id="@+id/readerHeader" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@color/wine_dark"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
        <Button android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="46dp"
            android:backgroundTint="@android:color/transparent" android:text="‹"
            android:textColor="#FFFFFF" android:textSize="27sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
            android:text="Derecho Canónico" android:textColor="#FFFFFF"
            android:textSize="17sp" android:textStyle="bold" />
        <Button android:id="@+id/btnCanonComments" android:layout_width="40dp"
            android:layout_height="46dp" android:backgroundTint="@android:color/transparent"
            android:contentDescription="Comentario disponible" android:text="▣"
            android:textColor="@color/gold" android:textSize="19sp" android:visibility="gone" />
        <Button android:id="@+id/btnCanonSearch" android:layout_width="40dp"
            android:layout_height="46dp" android:backgroundTint="@android:color/transparent"
            android:contentDescription="Buscar canon" android:text="⌕"
            android:textColor="@color/gold" android:textSize="21sp" />
        <Button android:id="@+id/btnReaderTheme" android:layout_width="40dp"
            android:layout_height="46dp" android:backgroundTint="@android:color/transparent"
            android:contentDescription="Cambiar tema" android:text="◐"
            android:textColor="@color/gold" android:textSize="20sp" />
        <Button android:id="@+id/btnGlobalMenu" android:layout_width="40dp"
            android:layout_height="46dp" android:backgroundTint="@android:color/transparent"
            android:contentDescription="Menú global" android:text="☰"
            android:textColor="#FFFFFF" android:textSize="19sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/canonSearchPanel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="vertical" android:padding="10dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/inputCanon" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:background="@drawable/bg_button_secondary" android:hint="Canon (1–1752)"
                android:inputType="number" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:textColor="@color/ink" android:textColorHint="@color/muted" />
            <Button android:id="@+id/btnFindCanon" android:layout_width="wrap_content"
                android:layout_height="48dp" android:layout_marginStart="8dp"
                android:backgroundTint="@color/wine" android:text="Ir" android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>
        <TextView android:id="@+id/txtCanonStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/muted" android:textSize="11sp" />
    </LinearLayout>
    <com.fabri.ministerium.MinisteriumWebView android:id="@+id/canonWebView"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
