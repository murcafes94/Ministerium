<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/wine_dark" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="10dp">
        <Button android:id="@+id/btnBack" android:layout_width="48dp"
            android:layout_height="48dp" android:backgroundTint="@android:color/transparent"
            android:text="‹" android:textColor="#FFFFFF" android:textSize="28sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Biblia de Jerusalén" android:textColor="#FFFFFF"
                android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Biblioteca bíblica sin conexión" android:textColor="#E9DBD7"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fillViewport="false" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="12dp"
            android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="6dp">
            <Button android:id="@+id/btnBibleBooks" android:layout_width="wrap_content"
                android:layout_height="46dp" android:background="@drawable/bg_button"
                android:text="Libros" android:textAllCaps="false" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnBibleRecent" android:layout_width="wrap_content"
                android:layout_height="46dp" android:layout_marginStart="7dp"
                android:background="@drawable/bg_button_secondary" android:text="Recientes"
                android:textAllCaps="false" android:textColor="@color/wine" />
            <Button android:id="@+id/btnBibleMarkers" android:layout_width="wrap_content"
                android:layout_height="46dp" android:layout_marginStart="7dp"
                android:background="@drawable/bg_button_secondary" android:text="Subrayados"
                android:textAllCaps="false" android:textColor="@color/wine" />
            <Button android:id="@+id/btnBiblePlans" android:layout_width="wrap_content"
                android:layout_height="46dp" android:layout_marginStart="7dp"
                android:background="@drawable/bg_button_secondary" android:text="Planes"
                android:textAllCaps="false" android:textColor="@color/wine" />
            <Button android:id="@+id/btnBibleSearch" android:layout_width="wrap_content"
                android:layout_height="46dp" android:layout_marginStart="7dp"
                android:background="@drawable/bg_button_secondary" android:text="Buscar en la Biblia"
                android:textAllCaps="false" android:textColor="@color/wine" />
        </LinearLayout>
    </HorizontalScrollView>
    <EditText android:id="@+id/inputBibleFilter" android:layout_width="match_parent"
        android:layout_height="50dp" android:layout_marginStart="16dp"
        android:layout_marginTop="6dp" android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card" android:hint="Buscar libro o abreviatura"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true"
        android:textColor="@color/ink" android:textColorHint="@color/muted" />
    <TextView android:id="@+id/txtBibleIntro" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginStart="18dp"
        android:layout_marginTop="10dp" android:layout_marginEnd="18dp"
        android:textColor="@color/muted" android:textSize="13sp" />
    <ListView android:id="@+id/listBibleItems" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_marginTop="7dp" android:layout_weight="1"
        android:divider="@android:color/transparent" android:dividerHeight="8dp"
        android:paddingStart="12dp" android:paddingEnd="12dp" />
</LinearLayout>
