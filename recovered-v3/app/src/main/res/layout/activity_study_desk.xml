<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/wine_dark" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="8dp">
        <Button android:id="@+id/btnBack" android:layout_width="48dp"
            android:layout_height="48dp" android:backgroundTint="@android:color/transparent"
            android:text="‹" android:textColor="#FFFFFF" android:textSize="28sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Mesa de estudio"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/btnStudyExport" android:layout_width="wrap_content"
            android:layout_height="44dp" android:backgroundTint="@android:color/transparent"
            android:text="Exportar" android:textAllCaps="false" android:textColor="@color/gold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp">
        <EditText android:id="@+id/inputStudyQuery" android:layout_width="0dp"
            android:layout_height="52dp" android:layout_weight="1"
            android:hint="Tema, referencia o etiqueta" android:imeOptions="actionSearch"
            android:inputType="text" android:singleLine="true" android:textColor="@color/ink"
            android:textColorHint="@color/muted" />
        <Button android:id="@+id/btnStudyDeskRun" android:layout_width="90dp"
            android:layout_height="52dp" android:layout_marginStart="8dp"
            android:backgroundTint="@color/wine" android:text="Buscar" android:textColor="#FFFFFF" />
    </LinearLayout>
    <TextView android:id="@+id/txtStudyDeskStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingBottom="8dp" android:textColor="@color/muted" android:textSize="13sp" />
    <ProgressBar android:id="@+id/studyDeskProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true"
        android:visibility="gone" />
    <ListView android:id="@+id/listStudyDeskResults" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
        android:divider="@android:color/transparent" android:dividerHeight="8dp"
        android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp"
        android:paddingBottom="12dp" />
</LinearLayout>
