<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#12100F" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/wine_dark" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <Button android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@android:color/transparent" android:text="‹" android:textColor="#FFFFFF" android:textSize="28sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txtPdfTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtPdfPage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E9DBD7" android:textSize="12sp" />
        </LinearLayout>
        <Button android:id="@+id/btnResetZoom" android:layout_width="60dp" android:layout_height="44dp" android:backgroundTint="@android:color/transparent" android:text="100%" android:textColor="@color/gold" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
        <EditText android:id="@+id/inputPdfPage" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_button_secondary" android:hint="Página PDF" android:inputType="number" android:paddingStart="12dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
        <Button android:id="@+id/btnGoPage" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="6dp" android:backgroundTint="@color/gold" android:text="Ir" android:textColor="@color/wine_dark" />
    </LinearLayout>
    <com.fabri.ministerium.ZoomImageView android:id="@+id/pdfImage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#12100F" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
        <Button android:id="@+id/btnPrevious" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:backgroundTint="@color/wine" android:text="Anterior" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnNext" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="8dp" android:layout_weight="1" android:backgroundTint="@color/wine" android:text="Siguiente" android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
